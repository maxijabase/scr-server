# Port the WebSocket relay server listens on
SCR_PORT=57452

# Discord bot token (https://discord.com/developers/applications)
SCR_DISCORD_TOKEN=

# Discord application/client ID, used to register slash commands
SCR_DISCORD_CLIENT_ID=

# If set, slash commands are registered to this single guild only (fast, for development).
# Leave unset to register commands globally (can take up to an hour to propagate).
SCR_DISCORD_GUILD_ID=

# Path to the SQLite database file
SCR_DATABASE_PATH=./data/scr.sqlite

# Log level: debug | info | warn | error
SCR_LOG_LEVEL=info
