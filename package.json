{
  "name": "scr-server",
  "version": "1.1",
  "description": "Source Chat Relay server -- TypeScript/Bun rewrite",
  "private": true,
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "discord.js": "^14.26.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.26.0",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2"
  }
}
